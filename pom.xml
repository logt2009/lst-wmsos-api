<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Información básica del proyecto -->
    <groupId>org.eon.wmsos</groupId>
    <artifactId>lst-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>OpenAPI Definition</name>
    <description>Proyecto que contiene la definición OpenAPI</description>

    <properties>
        <micronaut.openapi.generate.server>true</micronaut.openapi.generate.server>
        <micronaut.version>4.8.2</micronaut.version> <!-- Define la versión de Micronaut -->
    </properties>

    <!-- Dependencias (opcional) -->
    <dependencies>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-http-server-netty</artifactId>
            <version>${micronaut.version}</version>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-inject</artifactId>
            <version>${micronaut.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.0.2</version>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>2.1.1</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.17.0</version>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <version>3.6.4</version> <!-- O una versión compatible con tu stack -->
        </dependency>

        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
            <version>1.11.1</version>
        </dependency>

    </dependencies>


    <!-- Configuración de recursos -->
    <build>
        <resources>
            <resource>
                <directory>api</directory>
                <targetPath>api</targetPath>
                <includes>
                    <include>**/*.yaml</include>
                </includes>
            </resource>
            <resource>
                <directory>asyncapi</directory>
                <targetPath>asyncapi</targetPath>
                <includes>
                    <include>**/*.avsc</include>
                </includes>
            </resource>
        </resources>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version> <!-- Usa la versión más reciente del plugin -->
                <configuration>
                    <source>17</source> <!-- Versión de Java para el código fuente -->
                    <target>17</target> <!-- Versión de Java para el bytecode generado -->
                    <release>17</release> <!-- Opcional: Especifica la versión de Java -->
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro-maven-plugin</artifactId>
                <version>1.12.0</version> <!-- Asegurate de usar una versión compatible -->
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>schema</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/asyncapi/avro</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/asyncapi/src/main/java</outputDirectory>
                            <!-- Ensure all referenced types (e.g., StockDelta) have corresponding .avsc files in the source directory -->
                            <!-- Remove or fix references to missing types in your Avro schemas if necessary -->
                        </configuration>
                    </execution>
                </executions>
            </plugin>


            <!-- Plugin para generar clases a partir de OpenAPI -->
            <!--plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>6.2.0</version>
