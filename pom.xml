            <!-- Plugin para incluir las fuentes generadas en el compilador -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>
                                    ${project.build.directory}/generated-sources/openapi/src/main/java</source>
                                <source>
                                    ${project.build.directory}/generated-sources/asyncapi/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>io.micronaut.maven</groupId>
                <artifactId>micronaut-maven-plugin</artifactId>
                <version>${micronaut.version}</version>
                <executions>
                    <execution>
                        <id>generate-openapi</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate-openapi-server</goal>
                        </goals>
                        <configuration>
                            <definitionFile>api/wmsos/lst/openapi.yaml</definitionFile>
                            <outputDir>${project.build.directory}/generated-sources/openapi</outputDir>
                            <generatorName>micronaut</generatorName>
                            <apiPackageName>org.eon.wmsos.generated.api</apiPackageName>
                            <modelPackageName>org.eon.wmsos.generated.model</modelPackageName>
                            <invokerPackageName>org.eon.wmsos.generated.invoker</invokerPackageName>
                            <serializationFramework>jackson</serializationFramework>
                            <verbose>true</verbose>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-openapi-config</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate-openapi-server</goal>
                        </goals>
                        <configuration>
                            <definitionFile>api/wmsos/lst/openapi-config.yaml</definitionFile>
                            <outputDir>${project.build.directory}/generated-sources/openapi/config</outputDir>
                            <generatorName>micronaut</generatorName>
                            <apiPackageName>org.eon.wmsos.generated.api.config</apiPackageName>
                            <modelPackageName>org.eon.wmsos.generated.model.config</modelPackageName>
                            <invokerPackageName>org.eon.wmsos.generated.invoker.config</invokerPackageName>
                            <serializationFramework>jackson</serializationFramework>
                            <verbose>true</verbose>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-openapi-globalstock</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate-openapi-server</goal>
                        </goals>
                        <configuration>
                            <definitionFile>api/wmsos/lstglobal/openapi.yaml</definitionFile>
                            <outputDir>${project.build.directory}/generated-sources/openapi/config</outputDir>
                            <generatorName>micronaut</generatorName>
                            <apiPackageName>org.eon.wmsos.globalstock.generated.api</apiPackageName>
                            <modelPackageName>org.eon.wmsos.globalstock.generated.model</modelPackageName>
                            <invokerPackageName>org.eon.wmsos.globalstock.generated.invoker</invokerPackageName>
                            <serializationFramework>jackson</serializationFramework>
                            <verbose>true</verbose>
                            <additionalProperties>
                                <useTags>true</useTags>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

    </build>

</project>